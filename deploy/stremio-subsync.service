[Unit]
Description=stremio-subsync Stremio subtitle add-on
After=network-online.target
Wants=network-online.target

[Service]
# Holds the token, the AIOStreams link and API keys (root-only, 0600).
# Never copy them into this unit; deploy/env.sh writes them.
EnvironmentFile=/etc/stremio-subsync.env
ExecStart=/usr/local/bin/stremio-subsync
# Answered menus survive restarts and deploys here. With DynamicUser this is
# the only writable place.
StateDirectory=stremio-subsync
Environment=SUBSYNC_CACHE_DIR=%S/stremio-subsync/cache
# The server shuts down gracefully on Ctrl-C only.
KillSignal=SIGINT
Restart=on-failure
RestartSec=2

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX: glibc's resolver may ask nscd or systemd-resolved over a socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
